# E-Mail-Konfiguration für Fördertafel

# ==============================================
# MAIL CONFIGURATION
# ==============================================

# Mail Driver (smtp, sendmail, mailgun, ses, postmark, log, array)
MAIL_MAILER=smtp

# SMTP Configuration
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls

# From Address
MAIL_FROM_ADDRESS="noreply@foerdertafel.de"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================
# QUEUE CONFIGURATION
# ==============================================

# Queue Connection (sync, database, redis, sqs, beanstalkd)
# Für Entwicklung: sync oder database
# Für Produktion: redis (empfohlen)
QUEUE_CONNECTION=database

# ==============================================
# BEISPIEL-KONFIGURATIONEN FÜR VERSCHIEDENE ANBIETER
# ==============================================

# --- Mailtrap (für Tests) ---
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_mailtrap_username
# MAIL_PASSWORD=your_mailtrap_password
# MAIL_ENCRYPTION=tls

# --- SendGrid ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your_sendgrid_api_key
# MAIL_ENCRYPTION=tls

# --- Mailgun ---
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=mg.foerdertafel.de
# MAILGUN_SECRET=your_mailgun_secret
# MAILGUN_ENDPOINT=api.eu.mailgun.net

# --- Amazon SES ---
# MAIL_MAILER=ses
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=eu-central-1

# --- Postmark ---
# MAIL_MAILER=postmark
# POSTMARK_TOKEN=your_postmark_token

# --- Gmail (für Tests, nicht für Produktion empfohlen) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_gmail@gmail.com
# MAIL_PASSWORD=your_app_password
# MAIL_ENCRYPTION=tls

# ==============================================
# REDIS CONFIGURATION (für Queue)
# ==============================================

# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ==============================================
# HINWEISE
# ==============================================

# 1. Für Tests verwenden Sie Mailtrap.io
# 2. Für Produktion verwenden Sie einen professionellen Provider (SendGrid, Mailgun, SES)
# 3. Aktivieren Sie die Queue (QUEUE_CONNECTION=database oder redis)
# 4. Starten Sie den Queue-Worker: php artisan queue:work
# 5. Für Produktion: Verwenden Sie Supervisor für automatische Worker-Neustarts
